# Local-only secrets belong in .dev.vars and should not be committed.
APP_ENV=local
# Explicit Admin + Resident local Vite origins (no wildcards).
ADMIN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# When APP_ENV=local, MockSmsProvider logs OTPs to the Worker console for local E2E.
# Set DEV_OTP_LOG=false to suppress. Never enable in production.
# DEV_OTP_LOG=true

# OTP SMS delivery (Phase 1 — Arkesel transport)
# Local/CI default is mock — never sends paid/live SMS.
SMS_PROVIDER=mock
# For an explicit one-message local smoke test ONLY (opt-in; see AUTHENTICATION.md):
# SMS_PROVIDER=arkesel
# ARKESEL_API_KEY=<from Cloudflare/local secret — never commit>
# ARKESEL_SENDER_ID=<approved sender — do not invent KISSMET>
# ARKESEL_SMOKE_TO=233XXXXXXXXX
# ARKESEL_SMOKE_OPT_IN=YES_SEND_ONE_MESSAGE

# MikroTik connector (optional locally — missing → sync_failed safely)
# MIKROTIK_CONNECTOR_URL=http://127.0.0.1:8788
# MIKROTIK_CONNECTOR_SECRET=<local shared secret — never commit>

# Production secret placement (documentation only — use wrangler secret put):
#   npx wrangler secret put ARKESEL_API_KEY --env production
#   npx wrangler secret put MIKROTIK_CONNECTOR_SECRET --env production
