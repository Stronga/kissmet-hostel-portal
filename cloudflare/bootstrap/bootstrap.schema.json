{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kissmetgroup.org/schemas/bootstrap-production.v1.json",
  "title": "Kissmet production bootstrap config (v1)",
  "description": "Editor aid. scripts/bootstrap-production.mjs re-validates everything (placeholders, dev-seed fingerprints, cross references, uniqueness).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "superAdmin", "institutions", "leasePeriods", "rooms", "rateCards"],
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 160 },
    "upperCode": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]{0,39}$" },
    "periodCode": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z_-]{0,39}$" },
    "phone": { "type": "string", "pattern": "^\\+233[2-9]\\d{8}$" },
    "email": { "type": "string", "format": "email" },
    "periodStatus": { "enum": ["draft", "active", "closed"] },
    "rateStatus": { "enum": ["draft", "active", "inactive"] },
    "amountMinor": { "type": "integer", "minimum": 1, "maximum": 100000000 }
  },
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "notes": { "type": "string" },
    "organization": {
      "type": "object", "additionalProperties": false,
      "properties": { "name": { "$ref": "#/$defs/text" }, "supportEmail": { "$ref": "#/$defs/email" }, "supportPhone": { "$ref": "#/$defs/phone" }, "addressText": { "$ref": "#/$defs/text" } }
    },
    "superAdmin": {
      "type": "object", "additionalProperties": false,
      "required": ["displayName", "username", "email", "phone", "staffCode"],
      "properties": {
        "displayName": { "$ref": "#/$defs/text" },
        "username": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,31}$" },
        "email": { "$ref": "#/$defs/email" },
        "phone": { "$ref": "#/$defs/phone" },
        "staffCode": { "$ref": "#/$defs/upperCode" },
        "jobTitle": { "$ref": "#/$defs/text" }
      }
    },
    "institutions": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["code", "name"], "properties": { "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }, "name": { "$ref": "#/$defs/text" } } }
    },
    "academicSessions": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["code", "name", "startsOn", "endsOn", "status"], "properties": { "code": { "$ref": "#/$defs/periodCode" }, "name": { "$ref": "#/$defs/text" }, "startsOn": { "$ref": "#/$defs/date" }, "endsOn": { "$ref": "#/$defs/date" }, "status": { "$ref": "#/$defs/periodStatus" } } }
    },
    "leasePeriods": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["code", "name", "kind", "startsOn", "endsOn", "status"], "properties": { "code": { "$ref": "#/$defs/periodCode" }, "name": { "$ref": "#/$defs/text" }, "kind": { "enum": ["academic_calendar", "calendar_year", "short_term"] }, "academicSessionCode": { "type": ["string", "null"] }, "startsOn": { "$ref": "#/$defs/date" }, "endsOn": { "$ref": "#/$defs/date" }, "status": { "$ref": "#/$defs/periodStatus" } } }
    },
    "rooms": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["roomCode", "capacity", "genderPolicy"], "properties": { "roomCode": { "$ref": "#/$defs/upperCode" }, "roomName": { "$ref": "#/$defs/text" }, "floor": { "type": ["string", "integer"] }, "capacity": { "type": "integer", "minimum": 1, "maximum": 12 }, "genderPolicy": { "enum": ["female", "male", "any"] }, "status": { "enum": ["available", "maintenance", "inactive"] }, "bedLabels": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9]{1,4}$" }, "uniqueItems": true } } }
    },
    "rateCards": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "additionalProperties": false, "required": ["rateCode", "leasePeriodCode", "occupancyCapacity", "amountMinor", "status"], "properties": { "rateCode": { "$ref": "#/$defs/upperCode" }, "leasePeriodCode": { "$ref": "#/$defs/periodCode" }, "occupancyCapacity": { "enum": [1, 2, 4] }, "amountMinor": { "$ref": "#/$defs/amountMinor" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "packageMonths": { "type": ["integer", "null"], "minimum": 1, "maximum": 60 }, "status": { "$ref": "#/$defs/rateStatus" } } }
    },
    "roomRates": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": false, "required": ["rateCode", "roomCode", "academicSessionCode", "amountMinor", "status"], "properties": { "rateCode": { "$ref": "#/$defs/upperCode" }, "roomCode": { "$ref": "#/$defs/upperCode" }, "academicSessionCode": { "$ref": "#/$defs/periodCode" }, "amountMinor": { "$ref": "#/$defs/amountMinor" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "status": { "$ref": "#/$defs/rateStatus" } } }
    }
  }
}
