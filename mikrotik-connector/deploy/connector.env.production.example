# Kissmet MikroTik Connector — PRODUCTION env template for the on-site Raspberry Pi.
# TRUSTED-PROXY DEPLOYMENT ONLY: the connector listens on 127.0.0.1 and is reached solely through
# cloudflared (Cloudflare Tunnel) with Cloudflare Access in front of the public hostname.
#
# install.sh copies this to /etc/kissmet/mikrotik-connector.env (root:root 0600; systemd reads it
# before dropping privileges). PLACEHOLDERS ONLY — never commit real values. The connector refuses
# to start in production with placeholder secrets.

CONNECTOR_MODE=production
# Production always uses the real RouterOS client (mock is refused when CONNECTOR_MODE=production).
ROUTEROS_DRIVER=real

# Loopback only. cloudflared on the same host forwards https://<connector-hostname> → http://127.0.0.1:8788.
# The connector refuses a non-loopback BIND_HOST in production and whenever TRUST_PROXY=true.
BIND_HOST=127.0.0.1
PORT=8788

# Behind cloudflared every request arrives from 127.0.0.1; trust CF-Connecting-IP for rate-limit keys.
# ONLY valid in this trusted-proxy deployment (loopback bind + cloudflared). Dev/.env.example keeps false.
TRUST_PROXY=true

# Shared Bearer secret = Worker secret MIKROTIK_CONNECTOR_SECRET. >=32 random chars, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CONNECTOR_SECRET=replace-with-long-random-secret-at-least-32-chars

# RouterOS API over TLS (api-ssl). Pi LAN → router LAN address, never WireGuard .5.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_API_TLS=true
MIKROTIK_API_PORT=8729
# PEM of the RouterOS local CA (exported from the router; public, not secret). root:<service-group> 0640.
MIKROTIK_API_TLS_CA_FILE=/etc/kissmet/routeros-ca.pem
# Optional: SHA-256 pin of the api-ssl certificate (makes the pin authoritative instead of hostname/IP SAN).
# MIKROTIK_API_TLS_FINGERPRINT256=AA:BB:...
# Optional: name to verify the certificate against when it is issued for a DNS name, not the IP.
# MIKROTIK_API_TLS_SERVERNAME=router.kissmet.lan
# MIKROTIK_API_TLS_INSECURE_SKIP_VERIFY is refused in production.

MIKROTIK_API_USER=portal-api
MIKROTIK_API_PASSWORD=replace-with-router-secret

# Optional tuning (positive integers; invalid values stop startup)
# MAX_BODY_BYTES=16384
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# AUTH_FAIL_RATE_LIMIT_MAX=20
# ROUTEROS_TIMEOUT_MS=10000
