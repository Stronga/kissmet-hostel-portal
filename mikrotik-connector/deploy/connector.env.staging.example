# Kissmet MikroTik Connector — STAGING template (mock driver only).
#
# Staging does not use a connector by default: the Worker [env.staging] has no
# MIKROTIK_CONNECTOR_URL, so internet access shows "not configured".
# This file exists only if a later, approved staging mock connector is stood up
# on a separate host. It must NEVER point at the real MikroTik or the Raspberry Pi.
# Do not run install.sh / upgrade.sh or attempt SSH/network discovery from here.
#
# TRUST_PROXY=true remains restricted to the production trusted-proxy deployment
# (Pi + cloudflared, BIND_HOST=127.0.0.1). Staging keeps TRUST_PROXY=false.
# BIND_HOST stays loopback.

CONNECTOR_MODE=local
ROUTEROS_DRIVER=mock

BIND_HOST=127.0.0.1
PORT=8788
TRUST_PROXY=false

# Fresh staging secret if a mock connector is later approved — never a production copy.
CONNECTOR_SECRET=replace-with-staging-only-secret-at-least-32-chars

# Unused by the mock driver. Leave unset or clearly fake. Never a real router address.
# MIKROTIK_HOST=
# MIKROTIK_API_TLS=true
# MIKROTIK_API_PORT=8729
# MIKROTIK_API_USER=
# MIKROTIK_API_PASSWORD=
