# Kissmet MikroTik Connector — placeholders only. Never commit real values.
# Copy to /etc/kissmet/mikrotik-connector.env (mode 0600) or local .env (gitignored).

# local | production
CONNECTOR_MODE=local

# Listen address. Prefer 127.0.0.1 behind a reverse-proxy TLS terminator in production.
BIND_HOST=127.0.0.1
PORT=8788

# Shared Bearer secret with Worker MIKROTIK_CONNECTOR_SECRET (wrangler secret).
# Production: >=32 random chars. Never put in query strings, browser env, or git.
CONNECTOR_SECRET=replace-with-long-random-secret-at-least-32-chars

# RouterOS API over private WireGuard (peer .5 → 192.168.88.1:8728). Do not expose publicly.
MIKROTIK_HOST=192.168.88.1
MIKROTIK_API_PORT=8728
MIKROTIK_API_USER=portal-api
MIKROTIK_API_PASSWORD=replace-with-router-secret

# Optional tuning
# MAX_BODY_BYTES=16384
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=120
# ROUTEROS_TIMEOUT_MS=10000
