# Kissmet MikroTik Connector — placeholders only. Never commit real values.
# Copy to /etc/kissmet/mikrotik-connector.env (mode 0600) or local .env (gitignored).

# local | production
CONNECTOR_MODE=local

# RouterOS client driver: real | mock   (unset/empty = real)
#   real — node-routeros API client to MIKROTIK_HOST (default; the only option in production).
#   mock — in-memory fake router for local development / automated tests. Makes NO network
#          connection to any MikroTik; MIKROTIK_HOST / MIKROTIK_API_PASSWORD are ignored.
# The connector REFUSES TO START with ROUTEROS_DRIVER=mock when CONNECTOR_MODE=production
# (or NODE_ENV=production). Any other value is a startup error.
# Local dev on a PC that has the WireGuard peer to the hostel router: use mock.
ROUTEROS_DRIVER=real

# Listen address. Keep 127.0.0.1; Cloudflare Tunnel / local proxy fronts production.
# Production and TRUST_PROXY=true both REFUSE a non-loopback BIND_HOST.
BIND_HOST=127.0.0.1
PORT=8788

# Shared Bearer secret with Worker MIKROTIK_CONNECTOR_SECRET (wrangler secret).
# Production: >=32 random chars. Never put in query strings, browser env, or git.
CONNECTOR_SECRET=replace-with-long-random-secret-at-least-32-chars

# RouterOS API host/port — always the router LAN address.
# Production (Raspberry Pi): reach 192.168.88.1:8728 via direct hostel Ethernet/LAN (NOT WireGuard .5).
# Dev / remote test (current PC): same MIKROTIK_HOST, but traffic may traverse WireGuard peer .5.
# Do not expose 8728/8729 publicly. Application user is portal-api (never admin).
MIKROTIK_HOST=192.168.88.1
# Plain API (8728) is accepted ONLY in an explicitly non-production env (CONNECTOR_MODE=local above, or
# NODE_ENV=development/test). Production (CONNECTOR_MODE or NODE_ENV = production/prod) REFUSES TO START
# unless MIKROTIK_API_TLS=true + absolute MIKROTIK_API_TLS_CA_FILE + verification on.
# See deploy/connector.env.production.example.
# MIKROTIK_API_TLS=true                       # api-ssl; MIKROTIK_API_PORT then defaults to 8729
# MIKROTIK_API_TLS_CA_FILE=/path/to/routeros-ca.pem   # required with TLS (chain always verified)
# MIKROTIK_API_TLS_FINGERPRINT256=AA:BB:...   # optional SHA-256 pin
# MIKROTIK_API_TLS_SERVERNAME=router.lan      # optional; default MIKROTIK_HOST
# MIKROTIK_API_TLS_INSECURE_SKIP_VERIFY=false # lab only; refused in production
MIKROTIK_API_PORT=8728
MIKROTIK_API_USER=portal-api
MIKROTIK_API_PASSWORD=replace-with-router-secret

# Rate-limit client key. Default false: only the TCP socket address is used and
# X-Forwarded-For / X-Real-IP / CF-Connecting-IP are IGNORED (they are client-spoofable).
# Behind cloudflared every request arrives from 127.0.0.1, so with false ALL callers
# (Worker + anyone hitting the Tunnel hostname) share ONE bucket: a failed-auth flood can
# lock the Worker out for the window.
# Production behind cloudflared (BIND_HOST=127.0.0.1): set TRUST_PROXY=true. The key is then
# CF-Connecting-IP (set by Cloudflare's edge, not forgeable through Cloudflare), else the
# RIGHT-MOST X-Forwarded-For hop. Never set true if the port is reachable without the proxy
# (the connector refuses TRUST_PROXY=true unless BIND_HOST is loopback).
# Keep false for development; only deploy/connector.env.production.example sets true.
TRUST_PROXY=false

# Optional tuning
# MAX_BODY_BYTES=16384
# RATE_LIMIT_WINDOW_MS=60000          # window for both limits below
# RATE_LIMIT_MAX=120                  # authenticated requests per client key per window
# AUTH_FAIL_RATE_LIMIT_MAX=20         # failed-auth (401) attempts per key per window; then 429 lockout
# ROUTEROS_TIMEOUT_MS=10000
