# Local development (Vite dev server and tests). This fallback is also used
# when the variable is unset in development or test mode.
VITE_API_BASE_URL=http://localhost:8787

# Production and staging builds (`vite build`, mode=production) do not allow
# this fallback. Set an absolute https URL that is not localhost or 127.0.0.1,
# for example:
#   VITE_API_BASE_URL=https://api.kissmetgroup.org
#   VITE_API_BASE_URL=https://staging-api.kissmetgroup.org
# A missing, empty, http, or loopback value fails the production build and
# throws at runtime if a production bundle is started with an invalid value.
